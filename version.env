# Version info for Boombox
# Source this file in scripts: source "$ROOT/version.env"

MARKETING_VERSION=1.0
BUILD_NUMBER=1

# Sparkle auto-update config.
# SU_PUBLIC_ED_KEY is the EdDSA *public* key from Sparkle's generate_keys — it is
# NOT secret. The private key stays in the login Keychain and is never committed.
SU_FEED_URL=https://raw.githubusercontent.com/muunkk/Boombox/main/appcast.xml
SU_PUBLIC_ED_KEY=REPLACE_WITH_BASE64_PUBLIC_KEY_FROM_generate_keys
