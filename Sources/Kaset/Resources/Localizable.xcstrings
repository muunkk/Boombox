    "In-app shortcuts only fire while Boombox is active. They cannot conflict with shortcuts in other apps.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل الاختصارات داخل التطبيق فقط أثناء نشاط Boombox. لا يمكن أن تتعارض مع اختصارات التطبيقات الأخرى."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama içi kısayollar yalnızca Boombox etkinken çalışır. Diğer uygulamalardaki kısayollarla çakışamaz."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 내 단축키는 Boombox가 활성 상태일 때만 작동합니다. 다른 앱의 단축키와 충돌하지 않습니다."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan dalam aplikasi hanya aktif saat Boombox aktif. Pintasan ini tidak dapat bertentangan dengan pintasan di aplikasi lain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis intégrés ne fonctionnent que lorsque Boombox est actif. Ils ne peuvent pas entrer en conflit avec les raccourcis d’autres applications."
          }
        }
      }
    },
